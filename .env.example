DATABASE_URL=postgresql+asyncpg://aiops:aiops_dev_pwd@127.0.0.1:5436/aiops_mesh
TEST_DATABASE_URL=postgresql+asyncpg://aiops:aiops_dev_pwd@127.0.0.1:5436/aiops_mesh_test
REDIS_URL=redis://127.0.0.1:6386/0
TEST_REDIS_URL=redis://127.0.0.1:6386/1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8016
STEP_DELAY_MS=0
TASK_LEASE_SECONDS=30
WATCHDOG_INTERVAL_SECONDS=5
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_SECONDS=0.2
SHUTDOWN_TIMEOUT_SECONDS=10
AUTO_INIT_DB=false
EMBEDDED_WORKERS=false
ENABLE_FAULT_INJECTION=true
APPROVAL_TTL_SECONDS=900
TOOL_EXECUTION_MODE=mock

# A2A (Agent-to-Agent) External Peer Discovery
A2A_PEER_URLS=http://127.0.0.1:8020
A2A_AUTH_TOKEN=
A2A_TIMEOUT_SECONDS=5.0
ADAPTER_MODE=mock
GUIDANCE_NEO4J_URI=
GUIDANCE_RAG_METRICS_URL=

# RBAC Bearer API Tokens & Webhook Secret (override with strong random secrets in production)
APP_ENV=development
POSTGRES_PASSWORD=
VIEWER_API_TOKEN=viewer-demo-token
SRE_APPROVER_API_TOKEN=sre-approver-demo-token
RBAC_VIEWER_TOKEN=viewer-demo-token
RBAC_APPROVER_TOKEN=sre-approver-demo-token
ALERTMANAGER_WEBHOOK_SECRET=dev-alertmanager-webhook-secret

# LLM Provider: "mock" (default for tests) or "deepseek" / "openai"
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
