DATABASE_URL=postgresql+asyncpg://aiops:aiops_dev_pwd@127.0.0.1:5436/aiops_mesh
TEST_DATABASE_URL=postgresql+asyncpg://aiops:aiops_dev_pwd@127.0.0.1:5436/aiops_mesh_test
REDIS_URL=redis://127.0.0.1:6386/0
TEST_REDIS_URL=redis://127.0.0.1:6386/1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8016
STEP_DELAY_MS=0
TASK_LEASE_SECONDS=30
WATCHDOG_INTERVAL_SECONDS=5
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_SECONDS=0.2
SHUTDOWN_TIMEOUT_SECONDS=10
AUTO_INIT_DB=false
EMBEDDED_WORKERS=false
TOOL_EXECUTION_MODE=mock

# RBAC Bearer API Tokens (override in production)
RBAC_VIEWER_TOKEN=viewer-demo-token
RBAC_APPROVER_TOKEN=sre-approver-demo-token

# LLM Provider: "mock" (default for tests) or "deepseek" / "openai"
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
